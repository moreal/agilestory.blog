{
  "name": "agilestory",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "yarn workspaces foreach -At run build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "cli": "yarn workspace @agilestory/cli cli",
    "web": "yarn workspace agilestory.blog"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@effect/vitest": "4.0.0-rc.113",
    "@types/node": "^24.0.0",
    "effect": "4.0.0-rc.113",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
