{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "../../packages/web/src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "lib": ["dom", "ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  }
}
